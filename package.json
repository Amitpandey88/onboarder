{
  "name": "codebase-onboarder",
  "version": "1.2.0",
  "description": "Drop a path. Get a map. A zero-dependency codebase visualizer with a CLI onboarding wizard, a web UI, and an optional key-gated self-hosted mode.",
  "type": "module",
  "bin": {
    "onboarder": "bin/onboarder.js",
    "codebase-onboarder": "bin/onboarder.js"
  },
  "files": [
    "bin",
    "cli",
    "server",
    "shared",
    "public",
    "docs/HERMES_RESEARCH.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/SUPPLY_CHAIN_SECURITY.md",
    "SECURITY.md",
    "docs/ADVANCED_FEATURES.md",
    "docs/UNIFIED_REVIEW_FOUNDATION.md",
    "docs/CONTEXTUAL_AI_REVIEW.md",
    "docs/AI_FIX_VERIFICATION.md",
    "docs/PR_TRIAGE.md",
    "docs/PHASE4A_VERIFICATION.md",
    "docs/RELEASE_1.1.0.md",
    "docs/MIGRATING_TO_1.1.md",
    "integrations/vscode/package.json",
    "integrations/vscode/extension.cjs",
    "integrations/vscode/README.md",
    "scripts/package-editor.mjs",
    "docs/RELEASE_1.2.0.md"
  ],
  "scripts": {
    "build": "npm run typecheck && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.strict.json",
    "start": "node server/index.js",
    "mcp": "node server/mcp/standalone.js",
    "test": "npm run build && node --test",
    "benchmark:review": "npm run build && node scripts/benchmark-review.mjs",
    "prepublishOnly": "npm run check",
    "prestart": "node bin/build-if-source.js",
    "dev": "node scripts/dev.mjs",
    "build:check": "node scripts/check-build.mjs",
    "check": "npm run typecheck && npm test && npm run build:check && npm run security:check && npm run architecture:check",
    "prepack": "npm run build && npm run security:check",
    "security:check": "node scripts/check-supply-chain.mjs",
    "security:audit": "node scripts/audit-supply-chain.mjs",
    "editor:package": "node scripts/package-editor.mjs",
    "architecture:check": "npm run build && node bin/onboarder.js intelligence rules . --fail-on high --json"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codebase",
    "visualization",
    "architecture",
    "onboarding",
    "diagram",
    "mermaid",
    "mcp",
    "self-hosted",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amitpandey88/onboarder.git"
  },
  "homepage": "https://github.com/Amitpandey88/onboarder#readme",
  "bugs": "https://github.com/Amitpandey88/onboarder/issues",
  "author": "Amit Pandey",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
